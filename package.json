{
  "name": "mea-skills",
  "version": "2.9.0",
  "private": true,
  "description": "Personal agent skills with an interactive cross-platform installer",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "trivy-porter": "scripts/trivy-porter.mjs"
  },
  "scripts": {
    "mea-skills:install": "node scripts/install-skills.mjs",
    "mea-skills:version": "node scripts/mea-skills-version.mjs",
    "mea-skills:terminal-link": "node scripts/terminal-link.mjs",
    "mea-skills:terminal-unlink": "node scripts/terminal-unlink.mjs",
    "trivy-porter": "node scripts/trivy-porter.mjs",
    "version": "node scripts/sync-readme-version.mjs && git add README.md trivy-porter/VERSION",
    "test": "node --test",
    "test:trivy-porter": "python3 -B -m unittest discover -s tests -p \"test_*.py\""
  }
}
